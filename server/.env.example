# Decart platform key (dct_...) — server only, never ships in the app.
DECART_API_KEY=dct_xxx

# Shared secret the iOS app sends as x-mira-key. Any random string.
APP_SECRET=change-me

PORT=8787

# Optional overrides
# DECART_BASE=https://api.decart.ai
# VTON_MODEL=lucy-vton-3.5
# IMAGE_MODEL=lucy-image-2
# MAX_SESSION_SECONDS=120

# The spark ledger, in Firestore. The service-account JSON, or base64 of that JSON —
# base64 survives pasting into a deploy dashboard, a PEM full of newlines does not.
# Leave it unset and the ledger lives in memory and dies with the process.
FIREBASE_SERVICE_ACCOUNT=

# Optional overrides
# FIREBASE_PROJECT=mira-live-virtual-try-on   # only if not the key's own project
# FREE_SPARKS=15                              # what a brand-new wallet opens with
# MOCK_PURCHASE=1                             # let /v1/account/credit hand out sparks
#                                             # with no receipt. Dev only — it is a
#                                             # spark printer, and sparks cost money.
