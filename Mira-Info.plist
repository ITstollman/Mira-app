<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ponytail: dev only. The Mira server is plain http on the LAN; this key covers
	     unqualified hosts, .local and the private IP ranges. Delete it the day the
	     server is reachable over https. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- ponytail: Google's sign-in callback, nothing else. This is REVERSED_CLIENT_ID
	     copied verbatim out of GoogleService-Info.plist — re-copy it if that file is ever
	     regenerated, and Checks.run() will shout at launch if the two drift. Apple's flow
	     is in-process and needs no URL type. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.56688738822-23ejm4h2v716u93oo8lajrg3pte70ink</string>
			</array>
		</dict>
	</array>
	<!-- Substituted from MIRA_KEY in Secrets.xcconfig at build time. Never a
	     literal: this file is tracked and the repo is public. -->
	<key>MIRAKey</key>
	<string>$(MIRA_KEY)</string>
</dict>
</plist>
